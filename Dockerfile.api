# Read-only API image: no Chromium, no Playwright, ~180MB instead of ~1.1GB.
#
# This is what Render's free tier builds. Scraping runs elsewhere (GitHub
# Actions, see .github/workflows/scrape.yml) and writes to the same Postgres,
# so this container only ever serves reads.
#
# The browser code is import-guarded, so nothing here breaks: a scrape triggered
# on this host just skips the sources that need rendering.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PLAYWRIGHT_FALLBACK=false \
    SCHEDULER_ENABLED=false

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app ./app
COPY main.py ./

# Only used if someone points DATABASE_URL back at SQLite. On a free host that
# disk is wiped on every deploy, so production uses Postgres.
RUN mkdir -p /app/data

EXPOSE 8000

# Render (and most PaaS) inject the port to bind on; 8000 is the local default.
# One worker: the scrape lock is per-process.
CMD ["sh", "-c", "uvicorn app.api:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1 --proxy-headers --forwarded-allow-ips '*'"]
