# Copy to .env and adjust. Every value below is optional - these are defaults.

# ---------------------------------------------------------------- app
ENVIRONMENT=development
LOG_LEVEL=INFO

# ----------------------------------------------------------- database
# SQLite (default) is fine locally. Every deployed environment needs Postgres:
# free hosts wipe the disk on each deploy.
# Paste a provider URL exactly as given - "postgres://", "?sslmode=require" and
# "?channel_binding=require" are all rewritten for asyncpg at startup.
#   DATABASE_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL=sqlite+aiosqlite:///./data/jobs.db

# ---------------------------------------------------------------- api
API_HOST=0.0.0.0
API_PORT=8000
# Leave blank in dev. In production set a long random string; POST /scrape/run
# and the maintenance endpoint then require header: X-Admin-Token: <value>
ADMIN_TOKEN=
# Comma separated. Must list your real frontend origin in production.
# Scheme included, no trailing slash: https://app.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regex for frontends on rotating hostnames (preview/branch deploys).
# Anchored automatically. Example: https://.*\.my-app\.vercel\.app
CORS_ORIGIN_REGEX=
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=200

# ---------------------------------------------------------- scheduler
SCHEDULER_ENABLED=true
SCRAPE_INTERVAL_HOURS=6
SCRAPE_ON_STARTUP=false
STALE_AFTER_DAYS=21
PURGE_AFTER_DAYS=60

# ------------------------------------------------------------ scraping
SOURCES_ENABLED=naukri,linkedin
HTTP_CONCURRENCY=12
HTTP_TIMEOUT=25
HTTP_RETRIES=3
REQUEST_DELAY_MIN=0.15
REQUEST_DELAY_MAX=0.6

NAUKRI_PAGES=3
NAUKRI_PAGE_SIZE=100
LINKEDIN_PAGES=4
LINKEDIN_FETCH_DESCRIPTIONS=true

# Browser fallback: only fires when an HTTP endpoint returns nothing.
# Set false (and drop playwright from requirements) for a slim image.
PLAYWRIGHT_FALLBACK=true
PLAYWRIGHT_HEADLESS=true

# ----------------------------------------------------------- filtering
LOCATION=India
LINKEDIN_GEO_ID=102713980
# Keep postings whose minimum required experience is <= this.
MAX_EXPERIENCE_YEARS=3
INCLUDE_INTERNSHIPS=true
MAX_POSTING_AGE_DAYS=45
MIN_DESCRIPTION_CHARS=60
