# Copy to UI/.env.local

# Where the FastAPI service lives.
VITE_API_BASE=http://localhost:8000

# Only set this for a private/local dashboard. Vite inlines env vars into the
# bundle, so a token here is public to anyone who loads the page. For a public
# site, leave it blank and proxy POST /scrape/run through your own backend.
VITE_ADMIN_TOKEN=
